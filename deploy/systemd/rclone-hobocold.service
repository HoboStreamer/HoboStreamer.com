# rclone FUSE mount of the Backblaze B2 "openvibe" bucket at /mnt/hobo-cold.
# The VOD storage-tier manager (server/vod/storage-tier.js) migrates cold
# VODs into /mnt/hobo-cold/vods, which maps to the vods/ prefix in the bucket.
#
# Requirements:
#   - rclone + fuse3 installed (apt install rclone fuse3)
#   - "user_allow_other" enabled in /etc/fuse.conf (required so systemd can
#     build the hobostreamer sandbox namespace over the mount)
#   - a [b2vods] remote in /home/ubuntu/.config/rclone/rclone.conf with a
#     bucket-scoped application key (listBuckets, listFiles, readFiles,
#     writeFiles, deleteFiles)
#   - /mnt/hobo-cold and /var/cache/rclone-hobocold owned by ubuntu
[Unit]
Description=rclone mount — Backblaze B2 openvibe bucket (VOD cold storage)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/rclone mount b2vods:openvibe /mnt/hobo-cold \
    --config /home/ubuntu/.config/rclone/rclone.conf \
    --vfs-cache-mode writes \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 24h \
    --cache-dir /var/cache/rclone-hobocold \
    --buffer-size 16M \
    --dir-cache-time 30s \
    --transfers 4 \
    --allow-other \
    --log-level INFO
ExecStop=/bin/fusermount3 -uz /mnt/hobo-cold
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
